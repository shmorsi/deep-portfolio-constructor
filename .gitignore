# Environment
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Downloaded / generated data (re-creatable from the pipeline; never commit vendor data)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated run artefacts (figures ARE committed: the README and research note embed them)
reports/run_manifest.json
reports/run_manifest_*.json

# Notebook checkpoints
.ipynb_checkpoints/

# Trained network weights (re-creatable)
data/models/*
